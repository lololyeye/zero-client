{
  "name": "zero-client",
  "productName": "ZERO",
  "version": "0.3.1",
  "description": "ZERO - a personalized, performance-focused desktop client for the Discord web app",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "package": "npm run build && electron-builder --win nsis",
    "icons": "electron scripts/make-icons.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "oxlint": "^0.13.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "app.zero.client",
    "productName": "ZERO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZERO",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "ZERO-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lololyeye",
      "repo": "zero-client"
    }
  },
  "author": "lololyeye",
  "repository": {
    "type": "git",
    "url": "https://github.com/lololyeye/zero-client.git"
  },
  "homepage": "https://github.com/lololyeye/zero-client"
}
